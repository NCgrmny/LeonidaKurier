# ---------------------------------------------------------------------------
# Leonida Kurier – Reverse Proxy mit automatischem HTTPS.
#
# Caddy holt und erneuert die Zertifikate selbst. Beide Domains zeigen auf
# dieselbe Anwendung: Der Host-Header entscheidet, ob der Kompass direkt
# ausgeliefert wird (siehe src/proxy.ts). Caddy reicht den Host unveraendert
# weiter – ohne das wuerde die Erkennung nicht greifen.
# ---------------------------------------------------------------------------

leonidakurier.de, www.leonidakurier.de {
	encode zstd gzip
	reverse_proxy app:3000
}

leonidakompass.de, www.leonidakompass.de {
	encode zstd gzip
	reverse_proxy app:3000
}
