# ---------------------------------------------------------------------------
# Leonida Kurier – Beispielkonfiguration
# Kopieren nach `.env.local` (lokal) bzw. in die Vercel Project Settings.
# Alle Werte sind optional: Ohne sie laeuft die Plattform auf der Seed-Content-
# Schicht (src/content) und ist voll funktionsfaehig.
# ---------------------------------------------------------------------------

# Oeffentliche Basis-URL der Hauptdomain (fuer Metadaten, Sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL="https://leonidakurier.de"

# Eigene Domain fuer den Kompass-Einstieg. Requests auf diese Domain werden
# per Middleware auf /kompass umgeschrieben.
NEXT_PUBLIC_COMPASS_HOST="leonidakompass.de"

# --- Noch nicht aktiv, Schnittstellen sind vorbereitet ---------------------
# PostgreSQL (Phase 2: Ersetzt die Seed-Content-Schicht ueber dasselbe
# Repository-Interface, siehe src/lib/content/repository.ts).
# DATABASE_URL="postgresql://user:password@host:5432/leonida"

# Radar-Signalquellen (Phase 3, Orchestrierung ueber n8n).
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# X_BEARER_TOKEN=""
# YOUTUBE_API_KEY=""
